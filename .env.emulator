# Modo "emulator" (npm run dev:emulator). Valores ficticios: el prefijo "demo-" hace que
# Firebase CLI y el SDK trabajen 100% en local, sin tocar ningún proyecto real.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-taskflow.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-taskflow
VITE_FIREBASE_APP_ID=demo-app-id
